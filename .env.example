# honeywell_hvac.py configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env holds credentials -- keep it out of version control.


# --- Honeywell Total Connect Comfort account ----------------------------------

HONEYWELL_USERNAME=you@example.com
HONEYWELL_PASSWORD=


# --- SMTP -----------------------------------------------------------------
# Only required when using --sendemail.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
# Gmail App Password (16 characters, no spaces) -- not your normal account
# password. Requires 2-Step Verification; generate one at
# https://myaccount.google.com/apppasswords
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Comma-separated list of recipients. Required for --sendemail.
EMAIL_TO=you@example.com

# Optional. Defaults to SMTP_USERNAME.
EMAIL_FROM=

# Optional subject prefix. The run timestamp is always appended, and
# " - N error(s)" is inserted when any zone failed to collect.
EMAIL_SUBJECT_PREFIX=[Honeywell HVAC]


# --- API push (only used with --push-api) ---------------------------------
# Base URL of sensors-backend-fastapi, including the /v1 path segment --
# through nginx on rpi4-api, not uvicorn directly.
API_BASE_URL=http://10.0.0.13/v1
